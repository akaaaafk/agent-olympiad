# Copy to .env and fill in secrets (never commit .env)
TINKER_API_KEY=tml-your-key-here
PERPLEXITY_API_KEY=pplx-your-key-here
# Real OpenAI only; never put an OpenAgents gateway credential here.
OPENAI_API_KEY=sk-your-key-here

# Additional public interfaces (independent keys; explicit --model is required).
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=http://localhost:8000/v1

# Separate OpenAgents gateway; profile: configs/providers/openagents.json
OPENAGENTS_API_KEY=
# Optional backup only; never used automatically.
# OPENAGENTS_API_KEY_LEGACY=
OPENAGENTS_BASE_URL=https://api-gateway.openagents.org/v1
OPENAGENTS_MODEL=glm-5.2

# Optional defaults
VECTORENGINE_API_KEY=
VECTORENGINE_BASE_URL=https://api.vectorengine.ai/v1
VECTORENGINE_MODEL=claude-sonnet-5

# Optional defaults
TINKER_MODEL=Qwen/Qwen3.6-35B-A3B

# VJudge local gateway (semi-automatic remote submit)
# 1) Browser login to vjudge.net, DevTools → Network → copy Cookie header
# 2) python src/vjudge_gateway.py serve --port 8787
# 3) Set the vars below before running an agent batch
VJUDGE_COOKIE=
VJUDGE_GATEWAY_URL=http://127.0.0.1:8787
# Default: submit by problem id (CodeForces-4A) using benchmark evaluation fields.
# Set to "contest" only if you intentionally use a private VJudge contest.
VJUDGE_SUBMIT_MODE=problem
VJUDGE_OJ=CodeForces
# Optional contest-mode overrides (unused when VJUDGE_SUBMIT_MODE=problem):
# VJUDGE_CONTEST_ID=845103
# VJUDGE_PROBLEM=A
# VJUDGE_ACCESS_CODE=
# 0 = VJudge default remote account; 1 = own bound OJ account (required for CF here)
VJUDGE_SUBMIT_METHOD=1
# Optional per-OJ routing. These override the global values above, allowing one
# gateway to submit Codeforces tasks through Codeforces and ICPC tasks through Kattis.
# VJUDGE_SUBMIT_METHOD_CODEFORCES=1
# VJUDGE_BINDING_ID_CODEFORCES=319071
# VJUDGE_SUBMIT_METHOD_KATTIS=1
# VJUDGE_BINDING_ID_KATTIS=replace-with-kattis-binding-id
# Optional global fallback if no per-OJ binding is configured:
# VJUDGE_BINDING_ID=319071
# VJUDGE_CONTEST_VERSION=6c3
