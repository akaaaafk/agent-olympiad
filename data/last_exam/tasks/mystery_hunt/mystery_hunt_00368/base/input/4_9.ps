%!PS-Adobe-2.0

%%BeginProlog

% Basic Vertical Line
/vertline
{ 0 610 rlineto } def

% Basic Horizontal Line
/horizline
{ 531 0 rlineto } def

% Print Vertical Line
/printVlines
{newpath 0 0 moveto vertline stroke} def

%Print Horizontal Line
/printHlines
{newpath 0 0 moveto horizline stroke} def

% Outline around grid
/printBox
{newpath
    0 0 moveto
    0 540 lineto
    462 540 lineto
    462 0 lineto
    closepath
    stroke
} def

%Offset for lower left corner of grid
108 72 translate

% draw vertical lines
.1 setlinewidth
0 7 462 {printVlines 7 0 translate} for
-42 0 translate

% draw heavier division lines
.6 setlinewidth
427 -35 0 {printVlines -35 0 translate} for
-42 0 translate

% draw horizontal lines
.1 setlinewidth
0 7 541 {printHlines 0 7 translate} for
0 -511 translate

% draw heavier division lines
.6 setlinewidth
35 35 541 {printHlines 0 35 translate} for

% draw box
70 -561 translate
2 setlinewidth
printBox

-108 -72 translate


% Write in numbers

/Helvetica-Condensed findfont
[6 0 0 8 0 0] makefont
%6 scalefont
setfont

