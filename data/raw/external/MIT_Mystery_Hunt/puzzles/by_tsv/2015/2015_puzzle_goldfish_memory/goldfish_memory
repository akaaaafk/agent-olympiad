<center>
<noscript>You need JavaScript enabled for this puzzle.</noscript>
<div id="play_area">
</div>
<div>&nbsp;</div>
<div id="puzzle-session-error-message-container"></div>
</center>

<script src="https://web.mit.edu/puzzle/www/2015/static/puzzle_session.js"></script>

<script type='text/javascript'>
    var STATE_PICKING1 = 0;
    var STATE_LOADING1 = 1;
    var STATE_PICKING2 = 2;
    var STATE_LOADING2 = 3;
    var STATE_DISPLAYING = 4;

    var state = STATE_PICKING1;

    var session = new PuzzleSession("/dynamic/puzzle/goldfish_memory/flip_card");

    var NUM_CARDS = 36;
    var card_id1 = null;
    var card_id2 = null;
    var timeout = null;
    $(document).ready( function () {
        for (var i = 0; i < NUM_CARDS; i++) {
            $('#play_area').append("<div class='card notflipped' id='card"+ i + "'></div>");
        }
        $('.card').each(function () {
            $(this).click(function () {
                if (timeout !== null) {
                    resetState();
                    clearTimeout(timeout);
                    timeout = null;
                }

                var card_id = parseInt($(this).attr('id').substring(4));
                if (state == STATE_PICKING1 || state == STATE_PICKING2) {
                    if (state == STATE_PICKING2 && card_id == card_id1) {
                        return;
                    }

                    if (state == STATE_PICKING1)
                        state = STATE_LOADING1;
                    else
                        state = STATE_LOADING2;
                    session.json_request({action: "uncover", card: card_id}, function(res) {
                        var image_name = res.result;
                        if (state == STATE_LOADING1) {
                            setCardShow(card_id, image_name);
                            state = STATE_PICKING2;
                            card_id1 = card_id;
                        } else {
                            setCardShow(card_id, image_name);
                            state = STATE_DISPLAYING;
                            card_id2 = card_id;
                            timeout = setTimeout(function() {
                                resetState();
                                timeout = null;
                            }, 1500);
                        }
                    });
                }
            });
        });
    });

    function resetState() {
        setCardHidden(card_id1);
        setCardHidden(card_id2);
        state = STATE_PICKING1;
    }

    function setCardShow(card_id, image_name) {
        var el = $('#card' + card_id);
        el.css("background-image", "url('"+image_name+"')");
        el.addClass("flipped");
        el.removeClass("notflipped");
    }

    function setCardHidden(card_id) {
        var el = $('#card' + card_id);
        el.css("background-image", "");
        el.addClass("notflipped");
        el.removeClass("flipped");
    }
</script>

